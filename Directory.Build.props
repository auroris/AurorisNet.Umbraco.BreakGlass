<Project>
  <PropertyGroup>
    <!-- Compile against the first supported release; test compatibility with both Umbraco 17 and 18. -->
    <UmbracoMinimumVersion>17.0.0</UmbracoMinimumVersion>
    <!-- Default test-site version; override UmbracoVersion to test another supported release. -->
    <UmbracoVersion>18.3.1</UmbracoVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
