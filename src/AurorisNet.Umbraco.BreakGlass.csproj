<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AurorisNet.Umbraco.BreakGlass</PackageId>
    <!-- Only the package id carries the AurorisNet prefix; the assembly and namespace keep the plain name. -->
    <AssemblyName>BreakGlass</AssemblyName>
    <RootNamespace>BreakGlass</RootNamespace>
    <Title>Break Glass</Title>
    <!-- Local builds are a prerelease, so NuGet's cache never mixes them with a published version. The release
         workflow supplies the published version. -->
    <Version>0.0.0-local</Version>
    <Authors>Auroris</Authors>
    <Description>Emergency backoffice recovery for Umbraco 17 and 18: reset and unlock the built-in admin via configuration, or enable a debug-only sign-in bypass.</Description>
    <PackageTags>umbraco;umbraco-marketplace;backoffice;security;recovery;login;administrator</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/auroris/AurorisNet.Umbraco.BreakGlass</PackageProjectUrl>
    <RepositoryUrl>https://github.com/auroris/AurorisNet.Umbraco.BreakGlass</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/auroris/AurorisNet.Umbraco.BreakGlass/releases/tag/v$(Version)</PackageReleaseNotes>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <InternalsVisibleTo Include="BreakGlass.Tests" />
    <!-- The repository README is also the nuget.org page, which renders Markdown without HTML or relative links. -->
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../docs/images/icon.png" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
